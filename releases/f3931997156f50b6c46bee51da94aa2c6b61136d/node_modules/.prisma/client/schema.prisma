// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  INSTRUCTOR
  ADMIN
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          Role      @default(USER)
  headline      String?
  bio           String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  enrollments       Enrollment[]
  orders            Order[]
  reviews           Review[]
  progress          Progress[]
  certificates      Certificate[]
  courses           Course[]          @relation("InstructorCourses")
  submissions       UserSubmission[]
  discussions       Discussion[]
  discussionReplies DiscussionReply[]
  quizAttempts      QuizAttempt[]
  notes             StudyNote[]
  couponUsages      CouponUsage[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Category {
  id      String   @id @default(cuid())
  name    String
  nameEn  String
  slug    String   @unique
  icon    String?
  courses Course[]

  @@map("categories")
}

model Course {
  id            String      @id @default(cuid())
  slug          String      @unique
  title         String
  titleEn       String?
  description   String      @db.Text
  descriptionEn String?     @db.Text
  thumbnail     String?
  price         Float       @default(0)
  discountPrice Float?
  level         CourseLevel @default(BEGINNER)
  language      String      @default("id")
  duration      Int? // total minutes
  totalLessons  Int?
  published     Boolean     @default(false)
  featured      Boolean     @default(false)
  rating        Float?      @default(0)
  reviewCount   Int         @default(0)
  enrollCount   Int         @default(0)

  categoryId   String
  instructorId String

  whatYouLearn       String? @db.Text
  instructorHeadline String?
  instructorBio      String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category           Category            @relation(fields: [categoryId], references: [id])
  instructor         User                @relation("InstructorCourses", fields: [instructorId], references: [id])
  sections           Section[]
  enrollments        Enrollment[]
  orders             Order[]
  reviews            Review[]
  certificates       Certificate[]
  certificateSetting CertificateSetting?
  quizzes            Quiz[]
  assignments        Assignment[]
  discussions        Discussion[]
  resources          CourseResource[]
  notes              StudyNote[]
  coupons            Coupon[]

  @@index([categoryId])
  @@index([instructorId])
  @@index([published, featured])
  @@index([createdAt])
  @@map("courses")
}

model Section {
  id       String  @id @default(cuid())
  title    String
  titleEn  String?
  order    Int
  courseId String

  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     Lesson[]
  resources   CourseResource[]
  quizzes     Quiz[]
  assignments Assignment[]

  @@index([courseId])
  @@map("sections")
}

model Lesson {
  id        String  @id @default(cuid())
  title     String
  titleEn   String?
  slug      String
  videoUrl  String?
  duration  Int? // minutes
  isFree    Boolean @default(false)
  order     Int
  content   String? @db.Text
  sectionId String

  section  Section     @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  progress Progress[]
  notes    StudyNote[]

  @@unique([sectionId, slug])
  @@map("lessons")
}

model Enrollment {
  id          String    @id @default(cuid())
  userId      String
  courseId    String
  enrolledAt  DateTime  @default(now())
  completedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId])
  @@index([userId])
  @@map("enrollments")
}

model Progress {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String
  completedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([lessonId])
  @@index([userId])
  @@map("progress")
}

model Order {
  id              String      @id @default(cuid())
  userId          String
  courseId        String
  amount          Float
  status          OrderStatus @default(PENDING)
  midtransOrderId String?     @unique
  paymentMethod   String?
  paymentToken    String?     @db.Text
  paidAt          DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course         Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  couponId       String?
  discountAmount Float?  @default(0)
  coupon         Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([courseId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  rating    Int // 1-5
  comment   String?  @db.Text
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId])
  @@index([rating])
  @@map("reviews")
}

model Certificate {
  id              String   @id @default(cuid())
  userId          String
  courseId        String
  certificateCode String   @unique @default(cuid())
  issuedAt        DateTime @default(now())

  // Snapshot fields at issuance
  title          String?
  subtitle       String?
  issuerName     String?
  signatoryName1 String?
  signatoryRole1 String?
  signatoryName2 String?
  signatoryRole2 String?
  templateUrl    String?
  templateConfig Json?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId])
  @@index([issuedAt])
  @@map("certificates")
}

model CertificateSetting {
  id                        String   @id @default(cuid())
  courseId                  String   @unique
  isEnabled                 Boolean  @default(true)
  title                     String   @default("Certificate of Completion")
  subtitle                  String?  @default("Atas keberhasilannya dalam menyelesaikan seluruh modul kurikulum, evaluasi, dan pemenuhan kriteria kelulusan.")
  issuerName                String   @default("PT. Matoh Technologies Indonesia")
  signatoryName1            String?
  signatoryRole1            String?  @default("Lead Instructor & RnD Director")
  signatoryName2            String?  @default("Dr. E. Lovita, SE., Ak., M.Si., CA.")
  signatoryRole2            String?  @default("Head of Academic Board")
  templateUrl               String? // Custom certificate background template image
  templateConfig            Json? // Visual designer canvas config & element placeholders
  minProgress               Int      @default(100) // % minimal materi selesai
  requireQuizPassed         Boolean  @default(true) // semua kuis wajib lulus
  requireAssignmentApproved Boolean  @default(true) // semua tugas wajib approved
  serialPattern             String?  @default("MT/{COURSE_CODE}/{YEAR}/{COUNTER}")
  courseCode                String?
  counterPadding            Int      @default(4)
  nextCounter               Int      @default(1)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("certificate_settings")
}

model Quiz {
  id           String   @id @default(cuid())
  courseId     String
  sectionId    String?
  title        String
  description  String?  @db.Text
  passingScore Int      @default(70)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  course    Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  section   Section?       @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@index([courseId])
  @@index([sectionId])
  @@map("quizzes")
}

model QuizAttempt {
  id        String   @id @default(cuid())
  quizId    String
  userId    String
  score     Int
  passed    Boolean  @default(false)
  answers   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, quizId])
  @@map("quiz_attempts")
}

model QuizQuestion {
  id            String   @id @default(cuid())
  quizId        String
  question      String   @db.Text
  options       String[]
  correctAnswer Int      @default(0)
  explanation   String?  @db.Text
  order         Int      @default(1)

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@map("quiz_questions")
}

model Assignment {
  id          String   @id @default(cuid())
  courseId    String
  sectionId   String?
  title       String
  description String   @db.Text
  fileUrl     String?
  fileName    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  section     Section?         @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  submissions UserSubmission[]

  @@index([courseId])
  @@index([sectionId])
  @@map("assignments")
}

model UserSubmission {
  id          String    @id @default(cuid())
  taskId      String
  userId      String
  content     String    @db.Text
  fileUrl     String?
  fileName    String?
  fileSize    Int?
  status      String    @default("PENDING") // PENDING, APPROVED, REJECTED
  feedback    String?   @db.Text
  score       Int?
  submittedAt DateTime  @default(now())
  reviewedAt  DateTime?

  task Assignment @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId])
  @@index([status])
  @@map("user_submissions")
}

model Discussion {
  id        String   @id @default(cuid())
  courseId  String
  userId    String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course  Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies DiscussionReply[]

  @@index([courseId])
  @@index([userId])
  @@map("discussions")
}

model DiscussionReply {
  id           String   @id @default(cuid())
  discussionId String
  userId       String
  content      String   @db.Text
  createdAt    DateTime @default(now())

  discussion Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([discussionId])
  @@index([userId])
  @@map("discussion_replies")
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

model Coupon {
  id              String       @id @default(cuid())
  code            String       @unique
  discountType    DiscountType @default(PERCENTAGE)
  discountValue   Float // Percentage (e.g. 20 for 20%) or Fixed amount in IDR
  minPurchase     Float?       @default(0)
  maxDiscount     Float? // Cap for percentage discounts in IDR
  maxUsage        Int? // Limit total redemptions
  usedCount       Int          @default(0)
  maxUsagePerUser Int?         @default(1) // Limit redemptions per user
  courseId        String? // Optional: restricted to specific course
  allowedEmails   String?      @db.Text // Optional: comma-separated list of allowed user emails (whitelist)
  expiresAt       DateTime?
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  course Course?       @relation(fields: [courseId], references: [id], onDelete: SetNull)
  orders Order[]
  usages CouponUsage[]

  @@index([code])
  @@index([courseId])
  @@map("coupons")
}

model CouponUsage {
  id       String   @id @default(cuid())
  couponId String
  userId   String
  orderId  String?
  usedAt   DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([couponId, userId])
  @@map("coupon_usages")
}

model CourseResource {
  id          String   @id @default(cuid())
  courseId    String
  sectionId   String? // Optional: null means general / all chapters
  title       String
  description String?  @db.Text
  fileUrl     String   @db.Text
  fileName    String?
  fileSize    Int? // bytes
  type        String   @default("FILE") // FILE, PDF, GITHUB, FIGMA, SLIDE, ZIP, VIDEO, LINK
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  section Section? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  @@index([courseId])
  @@index([sectionId])
  @@map("course_resources")
}

model StudyNote {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  lessonId  String
  timestamp Int // seconds into video (e.g. 145 = 02:25)
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([userId, courseId])
  @@index([lessonId])
  @@map("study_notes")
}

model ContactInquiry {
  id          String    @id @default(cuid())
  name        String
  email       String
  phone       String?
  category    String
  institution String?
  message     String    @db.Text
  isRead      Boolean   @default(false)
  repliedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isRead])
  @@index([createdAt])
  @@map("contact_inquiries")
}
