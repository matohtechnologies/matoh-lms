# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/lms_platform?schema=public"

# NextAuth v5
AUTH_SECRET="dev-secret-key-change-in-production-1234567890"
AUTH_URL="http://localhost:3000"

# Midtrans Payment Gateway (Sandbox / Production)
MIDTRANS_SERVER_KEY="SB-Mid-server-xxxxx"
MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxx"
MIDTRANS_IS_PRODUCTION="false"

# Public App URLs & Keys
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxx"
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION="false"

# OAuth Google (Opsional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Resend Email Service
RESEND_API_KEY="re_xxxxxxxxxxxx"
EMAIL_FROM="Matoh Technologies <noreply@mail.matohtechnologies.com>"
